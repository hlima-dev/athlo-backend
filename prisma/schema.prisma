// ─────────────────────────────────────────────
//  ATHLO — Prisma Schema
//  SaaS de gestão para pequenas e médias empresas
// ─────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum ContactType {
  LEAD
  CUSTOMER
  SUPPLIER
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum InvoiceType {
  RECEIVABLE
  PAYABLE
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum InvoiceMethod {
  PIX
  CREDIT_CARD
  BANK_TRANSFER
  BOLETO
  CASH
  OTHER
}

enum EventType {
  MEETING
  TASK
  DEADLINE
  OTHER
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
  EVENT_REMINDER
  INVOICE_DUE
  INVOICE_PAID
  TEAM_INVITE
  SYSTEM
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  CREATED
  CONFIRMED
  IN_PREPARATION
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

enum OrderPaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum OrderPaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum OrderOrigin {
  MANUAL
  CALLCENTER
  SITE
  MERCADO_PAGO
}

enum TaxRegime {
  MEI
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

// Módulos com controle de acesso granular por MEMBER (OWNER/ADMIN sempre
// têm acesso total a todos, essa tabela nunca é consultada pra eles —
// ver requireModulePermission.ts).
enum OrgModule {
  CONTACTS
  INVOICES
  PRODUCTS
  ORDERS
  EVENTS
  INSUMOS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// ─── Tenant / Billing ────────────────────────

model Organization {
  id       String             @id @default(cuid())
  name     String
  slug     String             @unique
  document String?            // CNPJ/CPF
  email    String?
  phone    String?
  address  String?
  city     String?
  state    String?
  zipCode  String?
  logoUrl  String?
  status   OrganizationStatus @default(TRIAL)

  // Usado pelo lembrete de obrigação fiscal (scripts/sendTaxObligationReminders.ts)
  // — sem isso setado, a organização simplesmente não entra na rotina.
  taxRegime TaxRegime?

  // Metas exibidas em Relatórios ("Metas estratégicas") — nulo usa o
  // valor padrão calculado no frontend, pra empresa que ainda não
  // configurou as próprias metas.
  contactsGoal Int?
  eventsGoal   Int?
  revenueGoal  Decimal? @db.Decimal(12, 2)

  // Integração Mercado Pago (webhook de pagamento → pedido automático).
  // Texto puro — projeto não tem criptografia em repouso hoje, mesma
  // postura já usada pros secrets do Stripe (env var global). Nunca
  // devolvido pelo GET /organization/me, só um booleano "conectado".
  mercadoPagoAccessToken   String?
  mercadoPagoWebhookSecret String?

  users              User[]
  memberships        Membership[]
  contacts           Contact[]
  products           Product[]
  invoices           Invoice[]
  events             Event[]
  invites            Invite[]
  orders             Order[]
  subscription       Subscription?
  modulePermissions  ModulePermission[]
  taxReminderLogs    TaxReminderLog[]
  insumos            Insumo[]
  eventRecurrences   EventRecurrence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model Plan {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  priceMonthly  Decimal  @db.Decimal(10, 2)
  priceYearly   Decimal  @db.Decimal(10, 2)
  maxUsers      Int
  maxContacts   Int
  features      Json?
  stripePriceId String?
  isActive      Boolean  @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan               @relation(fields: [planId], references: [id])
  status         SubscriptionStatus @default(TRIALING)

  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  canceledAt       DateTime?

  // Preparado para integração futura com Stripe
  stripeCustomerId     String?
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model Invite {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrgRole   @default(MEMBER)
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?

  invitedById String?
  invitedBy   User?   @relation("InviteSender", fields: [invitedById], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@map("invites")
}

// ─── Usuários ────────────────────────────────

model User {
  id             String     @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  email    String     @unique
  password String
  orgRole  OrgRole    @default(MEMBER)
  status   UserStatus @default(ACTIVE)
  avatar   String?
  phone    String?

  // Administrador da plataforma ATHLO (equipe do próprio SaaS, não do cliente).
  // Enxerga todas as organizações — não confundir com OrgRole.OWNER, que é
  // o dono de uma empresa cliente.
  isPlatformAdmin Boolean @default(false)

  emailVerifiedAt      DateTime?
  emailVerifyToken     String?
  emailVerifyExpires   DateTime?

  // Bloqueio por força bruta na própria conta — complementa o rate limit
  // por IP (authLimiter), que sozinho não impede alguém de tentar a senha
  // de UMA conta específica trocando de IP a cada tentativa.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Tokens
  refreshToken         String?
  passwordResetToken   String?
  passwordResetExpires DateTime?

  // Relações
  notifications    Notification[]
  eventsCreated    Event[]        @relation("EventCreator")
  eventsAssigned   Event[]        @relation("EventAssignee")
  invoicesCreated  Invoice[]
  invitesSent      Invite[]       @relation("InviteSender")
  ordersOperated   Order[]        @relation("OrderOperator")
  memberships      Membership[]
  pushSubscriptions PushSubscription[]
  modulePermissions ModulePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("users")
}

// Um mesmo login (usuário/e-mail) pode ter acesso a mais de uma empresa —
// ex.: o dono de várias unidades/CNPJs sob a mesma identidade, como no
// seletor "Trocar Unidade" da referência que o cliente pediu. User.organizationId
// continua sendo a empresa "padrão" (criada no cadastro); Membership é a
// lista completa de empresas que esse login pode acessar, cada uma com seu
// próprio papel (dono de uma pode ser só membro de outra).
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgRole        OrgRole      @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ─── CRM ─────────────────────────────────────

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  email    String?
  phone    String?
  document String?       // CPF/CNPJ
  company  String?
  type     ContactType   @default(LEAD)
  status   ContactStatus @default(ACTIVE)

  address String?
  city    String?
  state   String?
  zipCode String?
  tags    String?        // JSON array como string
  notes   String?        @db.Text

  invoices    Invoice[]
  events      Event[]
  orders      Order[]
  insumoPrices InsumoPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("contacts")
}

// ─── Catálogo ────────────────────────────────

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?     @db.Text
  sku         String?
  type        ProductType @default(PRODUCT)
  price       Decimal     @db.Decimal(10, 2)
  active      Boolean     @default(true)

  // Controle de estoque opcional — nulo significa "não rastreado" (ex.:
  // serviços, ou produto cujo dono não quer controlar quantidade). Quando
  // setado, OrderService debita/devolve automaticamente ao criar, editar,
  // cancelar ou excluir um pedido que usa este produto.
  stockQty          Int?
  lowStockThreshold Int?

  // Calculadora de margem (ficha técnica) — todos opcionais, default "não
  // uso isso". productionCost vem da soma da receita (recipeItems), não é
  // um campo salvo — só esses 3 descontos extras ficam no produto.
  taxPercent        Decimal? @db.Decimal(5, 2)
  paymentFeePercent Decimal? @db.Decimal(5, 2)
  shippingCost      Decimal? @db.Decimal(10, 2)

  orderItems  OrderItem[]
  recipeItems RecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("products")
}

// ─── Insumos ─────────────────────────────────

model Insumo {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name   String
  unit   String // "kg" | "g" | "L" | "mL" | "unidade" | "pacote" | "dúzia" — texto livre, sem conversão entre unidades
  active Boolean @default(true)

  prices      InsumoPrice[]
  recipeItems RecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("insumos")
}

// Histórico de cotações — cada registro é "vi esse preço nesse fornecedor
// nessa data", nunca sobrescreve um preço anterior. Dá cotação atual (o
// mais recente por fornecedor) e histórico/tendência de graça.
model InsumoPrice {
  id       String @id @default(cuid())
  insumoId String
  insumo   Insumo @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  price      Decimal   @db.Decimal(10, 2)
  isPromo    Boolean   @default(false)
  validUntil DateTime? // só relevante quando isPromo=true; nulo = preço "normal", sem validade

  recordedAt DateTime @default(now())

  @@index([insumoId])
  @@map("insumo_prices")
}

// Ficha técnica — quanto de cada insumo um produto consome pra fazer 1 unidade.
model RecipeItem {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  insumoId  String
  insumo    Insumo  @relation(fields: [insumoId], references: [id])

  quantity Decimal @db.Decimal(10, 4)

  @@unique([productId, insumoId])
  @@map("recipe_items")
}

// ─── Financeiro ──────────────────────────────

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type        InvoiceType   @default(RECEIVABLE)
  description String
  amount      Decimal       @db.Decimal(10, 2)
  dueDate     DateTime
  status      InvoiceStatus @default(PENDING)
  method      InvoiceMethod?
  paidAt      DateTime?
  notes       String?       @db.Text

  // Marca quando o lembrete de vencida (e-mail) já foi disparado, pro
  // scripts/markAndRemindOverdueInvoices.ts não notificar duas vezes a
  // mesma fatura — mesmo padrão do Event.reminderSentAt.
  reminderSentAt DateTime?

  // Campo separado (não reaproveita reminderSentAt) porque é um aviso
  // diferente — "vence em breve", disparado por
  // scripts/sendInvoiceReminders.ts antes da fatura vencer. Reaproveitar
  // o mesmo campo faria a fatura "pular" o lembrete de vencida depois,
  // já que os dois scripts rodam em janelas de tempo diferentes.
  dueSoonReminderSentAt DateTime?

  // Chave de acesso (44 dígitos) da NF-e/NFC-e, quando a fatura nasceu de
  // uma importação de XML — permite detectar reimportação da mesma nota.
  accessKey String?

  // Conteúdo bruto do XML importado — sem isso, só a chave de acesso
  // sobrevivia e não havia como recuperar a nota original depois (ex.:
  // pro contador pedir o arquivo).
  xmlRaw String? @db.Text

  // Preenchido quando a fatura nasceu automaticamente de um pedido pago
  // (ver OrderService) — sem isso, Pedidos e Financeiro eram dois
  // registros desconectados da mesma venda.
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, accessKey])
  @@index([organizationId])
  @@index([organizationId, status, dueDate])
  @@map("invoices")
}

// ─── Pedidos ─────────────────────────────────

model Order {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  customerName  String
  customerPhone String?

  type   OrderType   @default(DELIVERY)
  status OrderStatus @default(CREATED)
  origin OrderOrigin @default(MANUAL)

  paymentMethod OrderPaymentMethod @default(PIX)
  paymentStatus OrderPaymentStatus @default(PENDING)

  address String?
  city    String?
  state   String?
  zipCode String?
  notes   String? @db.Text

  scheduledAt DateTime?
  total       Decimal   @db.Decimal(10, 2)

  operatorId String?
  operator   User?   @relation("OrderOperator", fields: [operatorId], references: [id])

  // Pedido criado automaticamente a partir de um PIX recebido no Mercado
  // Pago (ver MercadoPagoService) — item ainda é um placeholder até o
  // usuário identificar o que foi vendido de verdade.
  mercadoPagoPaymentId String?  @unique
  needsItemReview      Boolean  @default(false)

  items OrderItem[]

  // Fatura gerada automaticamente quando o pedido vira pago — ver
  // Invoice.orderId.
  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  name      String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@map("order_items")
}

// ─── Agenda ──────────────────────────────────

model Event {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title       String
  description String?     @db.Text
  type        EventType   @default(MEETING)
  status      EventStatus @default(SCHEDULED)

  location  String?
  isOnline  Boolean  @default(false)
  onlineUrl String?

  startDate DateTime
  endDate   DateTime
  allDay    Boolean  @default(false)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  createdById String
  createdBy   User   @relation("EventCreator", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("EventAssignee", fields: [assignedToId], references: [id])

  // Marca quando o lembrete (notificação + push) já foi disparado, para a
  // rotina agendada (scripts/sendEventReminders.ts) não notificar duas
  // vezes o mesmo compromisso.
  reminderSentAt DateTime?

  // Presente quando esse compromisso foi gerado (ou é a origem) de uma
  // rotina semanal — ver EventRecurrence. Cada ocorrência continua sendo
  // um Event independente (editar/excluir uma não afeta as outras).
  recurrenceId String?
  recurrence   EventRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("events")
}

// Molde de uma rotina semanal ("todo dia X") — independente dos Event
// que gera, pra continuar gerando mesmo se o compromisso de origem for
// editado/excluído depois. Parar a rotina (active=false) nunca apaga
// ocorrências já criadas, só impede novas.
model EventRecurrence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  active         Boolean      @default(true)

  title           String
  description     String?     @db.Text
  type            EventType
  location        String?
  isOnline        Boolean     @default(false)
  onlineUrl       String?
  allDay          Boolean     @default(false)
  dayOfWeek       Int // 0 (domingo) .. 6 (sábado), em UTC
  startHour       Int // 0-23, em UTC
  startMinute     Int
  durationMinutes Int // endDate - startDate do compromisso de origem

  contactId    String?
  assignedToId String?
  createdById  String

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("event_recurrences")
}

// Assinatura de notificação push do navegador (Web Push) de um usuário
// num dispositivo específico — cada navegador/aparelho gera a sua. Sem
// isso não tem como mandar notificação pro notebook/celular fora do site.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String @unique @db.Text
  p256dh    String
  auth      String
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ─── Notificações ────────────────────────────

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   NotificationType @default(INFO)
  title  String
  body   String
  data   String?          // JSON payload extra
  readAt DateTime?
  sentAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

// ─── Monitoramento ───────────────────────────

// Registro de erros 5xx não tratados, capturados no errorHandler — só
// visível no painel de administração da plataforma (requirePlatformAdmin).
// Não guarda erros operacionais esperados (AppError, validação Zod etc.),
// só o que realmente indica um bug.
model ErrorLog {
  id         String    @id @default(cuid())
  message    String
  stack      String?   @db.Text
  statusCode Int
  method     String
  path       String

  userId         String?
  organizationId String?

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([resolvedAt])
  @@map("error_logs")
}

// Registro de ações de negócio (criar/editar/excluir contato, fatura,
// pedido, produto, compromisso) — diferente do ErrorLog, que é só bug;
// esse é "quem fez o quê", visível pro próprio tenant (OWNER/ADMIN),
// não só pra plataforma. Sem FK em userId/organizationId de propósito
// (mesmo motivo do ErrorLog): log barato de escrever, não quebra se o
// usuário ou a organização forem removidos depois. Nome/e-mail de quem
// fez não é duplicado aqui — é resolvido em lote na leitura.
model AuditLog {
  id             String      @id @default(cuid())
  organizationId String?
  userId         String?

  entityType String
  entityId   String
  action     AuditAction
  summary    String

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// Controle de acesso por módulo — só consultado pra orgRole MEMBER
// (OWNER/ADMIN sempre passam direto, ver requireModulePermission.ts).
// Backfill inicial (scripts/backfillModulePermissions.ts) cria um
// registro habilitado em cada módulo pra todo membro já existente, pra
// ninguém perder acesso no rollout — membros convidados depois nascem
// sem nenhum módulo liberado, até o OWNER/ADMIN conceder.
model ModulePermission {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  module         OrgModule
  enabled        Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, module])
  @@index([organizationId])
  @@map("module_permissions")
}

// Prazo recorrente de uma obrigação fiscal (ex: DAS do dia 20) — mantido
// pelo time ATHLO, não editável pelo cliente. Independente de
// organização: uma linha por regime+tributo, reaproveitada por todas as
// empresas naquele regime.
model TaxDeadline {
  id         String    @id @default(cuid())
  regime     TaxRegime
  label      String
  dayOfMonth Int

  reminderLogs TaxReminderLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tax_deadlines")
}

// Guarda de "já lembrei essa organização desse prazo nesse mês" —
// diferente do lembrete de fatura/evento (pontual), obrigação fiscal se
// repete todo mês, então a chave de dedupe precisa do mês de referência.
model TaxReminderLog {
  id              String      @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxDeadlineId   String
  taxDeadline     TaxDeadline @relation(fields: [taxDeadlineId], references: [id], onDelete: Cascade)
  remindedForMonth String     // formato "AAAA-MM"

  createdAt DateTime @default(now())

  @@unique([organizationId, taxDeadlineId, remindedForMonth])
  @@map("tax_reminder_logs")
}
