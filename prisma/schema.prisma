// ─────────────────────────────────────────────
//  ATHLO — Prisma Schema
//  SaaS de gestão para pequenas e médias empresas
// ─────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum ContactType {
  LEAD
  CUSTOMER
  SUPPLIER
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum InvoiceType {
  RECEIVABLE
  PAYABLE
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum InvoiceMethod {
  PIX
  CREDIT_CARD
  BANK_TRANSFER
  BOLETO
  CASH
  OTHER
}

enum EventType {
  MEETING
  TASK
  DEADLINE
  OTHER
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
  EVENT_REMINDER
  INVOICE_DUE
  INVOICE_PAID
  TEAM_INVITE
  SYSTEM
}

// ─── Tenant / Billing ────────────────────────

model Organization {
  id       String             @id @default(cuid())
  name     String
  slug     String             @unique
  document String?            // CNPJ/CPF
  email    String?
  phone    String?
  address  String?
  city     String?
  state    String?
  zipCode  String?
  logoUrl  String?
  status   OrganizationStatus @default(TRIAL)

  users        User[]
  contacts     Contact[]
  products     Product[]
  invoices     Invoice[]
  events       Event[]
  invites      Invite[]
  subscription Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model Plan {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  priceMonthly  Decimal  @db.Decimal(10, 2)
  priceYearly   Decimal  @db.Decimal(10, 2)
  maxUsers      Int
  maxContacts   Int
  features      Json?
  stripePriceId String?
  isActive      Boolean  @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan               @relation(fields: [planId], references: [id])
  status         SubscriptionStatus @default(TRIALING)

  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  canceledAt       DateTime?

  // Preparado para integração futura com Stripe
  stripeCustomerId     String?
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model Invite {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrgRole   @default(MEMBER)
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?

  invitedById String?
  invitedBy   User?   @relation("InviteSender", fields: [invitedById], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@map("invites")
}

// ─── Usuários ────────────────────────────────

model User {
  id             String     @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  email    String     @unique
  password String
  orgRole  OrgRole    @default(MEMBER)
  status   UserStatus @default(ACTIVE)
  avatar   String?
  phone    String?

  // Tokens
  refreshToken         String?
  passwordResetToken   String?
  passwordResetExpires DateTime?

  // Relações
  notifications    Notification[]
  eventsCreated    Event[]        @relation("EventCreator")
  eventsAssigned   Event[]        @relation("EventAssignee")
  invoicesCreated  Invoice[]
  invitesSent      Invite[]       @relation("InviteSender")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("users")
}

// ─── CRM ─────────────────────────────────────

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  email    String?
  phone    String?
  document String?       // CPF/CNPJ
  company  String?
  type     ContactType   @default(LEAD)
  status   ContactStatus @default(ACTIVE)

  address String?
  city    String?
  state   String?
  zipCode String?
  tags    String?        // JSON array como string
  notes   String?        @db.Text

  invoices Invoice[]
  events   Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("contacts")
}

// ─── Catálogo ────────────────────────────────

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?     @db.Text
  sku         String?
  type        ProductType @default(PRODUCT)
  price       Decimal     @db.Decimal(10, 2)
  active      Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("products")
}

// ─── Financeiro ──────────────────────────────

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type        InvoiceType   @default(RECEIVABLE)
  description String
  amount      Decimal       @db.Decimal(10, 2)
  dueDate     DateTime
  status      InvoiceStatus @default(PENDING)
  method      InvoiceMethod?
  paidAt      DateTime?
  notes       String?       @db.Text

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("invoices")
}

// ─── Agenda ──────────────────────────────────

model Event {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title       String
  description String?     @db.Text
  type        EventType   @default(MEETING)
  status      EventStatus @default(SCHEDULED)

  location  String?
  isOnline  Boolean  @default(false)
  onlineUrl String?

  startDate DateTime
  endDate   DateTime
  allDay    Boolean  @default(false)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  createdById String
  createdBy   User   @relation("EventCreator", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("EventAssignee", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("events")
}

// ─── Notificações ────────────────────────────

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   NotificationType @default(INFO)
  title  String
  body   String
  data   String?          // JSON payload extra
  readAt DateTime?
  sentAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}
